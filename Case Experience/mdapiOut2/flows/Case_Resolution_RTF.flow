<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <label>Case Resolution RTF</label>
    <status>Draft</status>
    <processType>AutoLaunchedFlow</processType>

    <start>
        <locationX>182</locationX>
        <locationY>0</locationY>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Web</stringValue>
            </value>
        </filters>
        <scheduledPaths>
            <name>Async_Callout_Path</name>
            <connector>
                <targetReference>Set_Prompt_Request_Id</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
    </start>

    <assignments>
        <name>Set_Prompt_Request_Id</name>
        <label>Set Prompt Request ID</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>promptRequestId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>REPLACE_WITH_YOUR_GPTFY_PROMPT_RECORD_ID</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Event_UUID</targetReference>
        </connector>
    </assignments>

    <assignments>
        <name>Set_Event_UUID</name>
        <label>Set Event UUID</label>
        <locationX>182</locationX>
        <locationY>268</locationY>
        <assignmentItems>
            <assignToReference>eventUUID</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Call_GPTfy_RAG_Action</targetReference>
        </connector>
    </assignments>

    <actionCalls>
        <name>Call_GPTfy_RAG_Action</name>
        <label>Call GPTfy RAG Action</label>
        <locationX>182</locationX>
        <locationY>402</locationY>
        <actionName>ccai__AIPromptProcessingInvokable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Create_Case_Comment</targetReference>
        </connector>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>promptRequestId</name>
            <value>
                <elementReference>promptRequestId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>eventUUID</name>
            <value>
                <elementReference>eventUUID</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>customPromptCommand</name>
            <value>
                <elementReference>$Record.Description</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>recommendationText</assignToReference>
            <name>responseBody</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>gptfyStatus</assignToReference>
            <name>status</name>
        </outputParameters>
    </actionCalls>

    <recordCreates>
        <name>Create_Case_Comment</name>
        <label>Create Case Comment (AI Recommendation)</label>
        <locationX>182</locationX>
        <locationY>536</locationY>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CommentBody</field>
            <value>
                <elementReference>recommendationText</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsPublished</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>CaseComment</object>
    </recordCreates>

    <variables>
        <name>promptRequestId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>eventUUID</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>recommendationText</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <variables>
        <name>gptfyStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

</Flow>
