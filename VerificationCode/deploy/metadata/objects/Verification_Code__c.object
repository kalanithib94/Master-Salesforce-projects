    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores temporary email verification codes generated during the Salesforce login flow. Records are automatically expired and cleaned up after 24 hours.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Verification Code</label>
    <nameField>
        <displayFormat>VC-{0000000}</displayFormat>
        <label>Verification Code Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Verification Codes</pluralLabel>
    <searchLayouts></searchLayouts>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Attempt_Count__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Number of incorrect verification attempts made against this code. Incremented on each wrong entry; access is blocked at 3.</description>
        <externalId>false</externalId>
        <label>Attempt Count</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Code_Hash__c</fullName>
        <description>SHA-256 hash of the verification code. The plain-text code is never stored.</description>
        <externalId>false</externalId>
        <label>Code Hash</label>
        <length>64</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Expiry_Time__c</fullName>
        <description>The exact date/time when this verification code expires (5 minutes after generation).</description>
        <externalId>false</externalId>
        <label>Expiry Time</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Is_Used__c</fullName>
        <defaultValue>false</defaultValue>
        <description>True when this code has been successfully verified or explicitly invalidated (e.g., a new code was generated). Consumed codes are never re-accepted.</description>
        <externalId>false</externalId>
        <label>Is Used</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The Salesforce user this verification code belongs to.</description>
        <externalId>false</externalId>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Verification Codes</relationshipLabel>
        <relationshipName>Verification_Codes</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
</CustomObject>
